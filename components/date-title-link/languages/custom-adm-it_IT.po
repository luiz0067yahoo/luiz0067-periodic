#: js/blocks/date-title-link.js
msgid "Data, Título e Link"
msgstr "Data, Titolo e Link"

#: js/blocks/date-title-link.js
msgid "Exibe publicações oficiais, editais ou notícias com data, título descritivo e URL de redirecionamento."
msgstr "Mostra bandi ufficiali, avvisi o notizie con data, titolo descrittivo e URL di reindirizzamento."

#: js/blocks/date-title-link.js
msgid "data"
msgstr "data"

#: js/blocks/date-title-link.js
msgid "título"
msgstr "titolo"

#: js/blocks/date-title-link.js
msgid "link"
msgstr "link"

#: js/blocks/date-title-link.js
msgid "edital"
msgstr "bando"

#: js/blocks/date-title-link.js
msgid "notícia"
msgstr "notizia"

#: js/blocks/date-title-link.js
msgid "Edital de Concurso Público Nº 04/2026 - Convocação para Provas Objetivas"
msgstr "Bando di Concorso Pubblico N. 04/2026 - Convocazione alle Prove"

#: js/blocks/date-title-link.js
msgid "Configurações do Link e Publicação"
msgstr "Impostazioni del Link e Pubblicazione"

#: js/blocks/date-title-link.js
msgid "URL de Redirecionamento"
msgstr "URL di Reindirizzamento"

#: js/blocks/date-title-link.js
msgid "Endereço para onde o usuário será direcionado ao clicar no item."
msgstr "Indirizzo a cui l'utente verrà reindirizzato facendo clic sull'elemento."

#: js/blocks/date-title-link.js
msgid "Abrir link em nova aba (_blank)"
msgstr "Apri link in una nuova scheda (_blank)"

#: js/blocks/date-title-link.js
msgid "O link será aberto em uma nova guia do navegador."
msgstr "Il link verrà aperto in una nuova scheda del browser."

#: js/blocks/date-title-link.js
msgid "O link será aberto na mesma página."
msgstr "Il link verrà aperto nella stessa pagina."

#: js/blocks/date-title-link.js
msgid "Data da Publicação / Evento"
msgstr "Data di Pubblicazione / Evento"

#: js/blocks/date-title-link.js
msgid "Ex: 11/09/2026 ou 11 de Setembro"
msgstr "Es: 11/09/2026 o 11 Settembre"

#: js/blocks/date-title-link.js
msgid "Você também pode editar a data diretamente no bloco."
msgstr "È inoltre possibile modificare la data direttamente nel blocco."

#: js/blocks/date-title-link.js
msgid "Data (ex: 11/09/2026)"
msgstr "Data (es: 11/09/2026)"

#: js/blocks/date-title-link.js
msgid "Digite o título descritivo do edital, notícia ou publicação oficial..."
msgstr "Inserisci il titolo descrittivo del bando, notizia o pubblicazione..."

#: js/blocks/date-title-link.js
msgid "URL não informada (clique para definir na barra lateral)"
msgstr "URL non impostato (fai clic per configurare nella barra laterale)"

